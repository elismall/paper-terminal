# Paper Terminal settings. Put these in Vercel → your project → Settings → Environment Variables (never in the code, never in chat).
# Required
ALPACA_KEY_ID=            # Alpaca PAPER API key id (app.alpaca.markets → Paper → API Keys)
ALPACA_SECRET_KEY=        # Alpaca PAPER secret key (shown once; mark Sensitive)
DASH_PASSCODE=            # your app passcode: 12+ characters (a short sentence works well)
CRON_SECRET=              # a long random string; the scheduler sends it, and it also protects sign-in
# Added automatically when you connect a Blob store (Vercel → Storage)
BLOB_READ_WRITE_TOKEN=
# Optional
APP_NAME=                 # the name on screen (default: Paper Terminal)
VAPID_PUBLIC_KEY=         # phone notifications (generate both in the setup guide)
VAPID_PRIVATE_KEY=
FRED_API_KEY=             # Macro tab (free at fred.stlouisfed.org)
SEC_USER_AGENT=           # company financials: "Your Name your@email.com"
TYPESAFE_API_KEY=         # Jev AI second opinion (optional, paid per use)
BOT_PAUSED=               # true = no new trades (emergency brake; remove it to resume)
# Real money (advanced; leave empty for paper). ALL of these must be set or the bots stay on paper.
TRADING_MODE=             # live
LIVE_CONFIRM=             # exactly: I understand this trades real money
ALPACA_LIVE_KEY_ID=       # keys from your LIVE Alpaca account
ALPACA_LIVE_SECRET_KEY=
LIVE_MAX_USD=             # the most the bots may have in the market at once, e.g. 100
